<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(data:image/webp;base64,);">
  <div class="container">
    <h1>Save any kinf of <strong>movies</strong>!</h1>
  </div>
</div>

<div class="container">
  <nav class="navbar navbar-light bg-light">
      <div class="container-fluid">
        <a class="navbar-brand p-2">My lists</a>
        <form class="d-flex">
          <%= link_to "New list", new_list_path, class: "btn btn-outline-primary p-2" %>
        </form>
      </div>
    </nav>
    <div class="cards">
       <% @lists.each do |rest| %>
       <div class="card-category container card-pers" style="background-image: url(https://th.bing.com/th/id/OIP.u86CivzOcai6CSdsuxDgBwHaDe?w=310&h=164&c=7&r=0&o=7&dpr=1.3&pid=1.7&rm=3)">
            <%= link_to "#{rest.name}", list_path(rest) %>
        </div>
       <% end %>
    </div>
</div>
